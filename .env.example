# Copy to .env.local (git-ignored) and adjust.
# Vite inlines VITE_* variables into the browser bundle at build time: never put secrets here.

# Origin of the profound-baker-server API (no trailing slash). Item image URLs are relative to it.
# Leave empty when one reverse proxy serves both the SPA and the API (same origin).
VITE_API_BASE_URL=http://localhost:8080

# How prices are shown. The API sends plain numbers without a currency.
# VITE_CURRENCY: ISO 4217 code (default CAD). VITE_LOCALE: BCP 47 tag for number/date format (default en-US).
VITE_CURRENCY=CAD
VITE_LOCALE=en-US
