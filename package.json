{
  "name": "profound-baker-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:generate": "npm exec --yes --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 -- openapi-typescript openapi/openapi.json -o src/api/schema.d.ts",
    "api:types": "npm run api:fetch && npm run api:generate",
    "api:check": "npm exec --yes --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 -- openapi-typescript openapi/openapi.json -o src/api/schema.d.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.108.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
